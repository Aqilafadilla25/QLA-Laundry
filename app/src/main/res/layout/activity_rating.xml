<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCEBF2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rating dan Ulasan"
            android:textColor="#242124"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bagaimana pengalaman laundry kamu?"
            android:textColor="#777777"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="12dp"/>

        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1.0"
            android:rating="0"
            android:progressTint="#E91E63"
            android:secondaryProgressTint="#F3B6CE"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/tvNilaiRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih bintang 1-5"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/etUlasan"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:hint="Tuliskan pengalaman kamu..."
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:padding="14dp"
            android:backgroundTint="#D85B91"
            android:layout_marginTop="30dp"/>

        <Button
            android:id="@+id/btnKirimUlasan"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Kirim Ulasan"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#E91E63"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ulasan Sebelumnya"
            android:textColor="#242124"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="35dp"/>

        <TextView
            android:id="@+id/tvHasilUlasan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada ulasan."
            android:textColor="#555555"
            android:textSize="14sp"
            android:padding="15dp"
            android:background="#FFFFFF"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>
