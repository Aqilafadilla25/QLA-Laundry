<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCEAF2"
    android:fillViewport="true"
    tools:context=".ProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Judul halaman -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PROFIL DEVELOPER"
            android:textColor="#E91E63"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Foto atau avatar -->
        <TextView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:gravity="center"
            android:text="👩🏻‍💻"
            android:textSize="58sp"
            android:background="#FFFFFF"
            android:elevation="4dp" />

        <!-- Nama developer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aqila"
            android:textColor="#29212A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mahasiswa | Android Developer"
            android:textColor="#8B526B"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- Kartu informasi profil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tentang Saya"
                android:textColor="#E91E63"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Halo! Saya Aqila, mahasiswa yang tertarik mempelajari teknologi dan pengembangan aplikasi Android. Laundry Express merupakan project aplikasi layanan laundry yang dirancang agar pengguna lebih mudah mengakses informasi dan layanan laundry."
                android:textColor="#403840"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F5D6E4"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hobi"
                android:textColor="#E91E63"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="♫ Mendengarkan musik\n♡ Mencoba hal baru"
                android:textColor="#403840"
                android:textSize="14sp"
                android:lineSpacingExtra="7dp"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F5D6E4"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kekuatan Terbesar"
                android:textColor="#E91E63"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Teliti saat mengerjakan tugas\n• Mau belajar dari kesalahan\n• Pantang menyerah saat menghadapi masalah"
                android:textColor="#403840"
                android:textSize="14sp"
                android:lineSpacingExtra="7dp"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F5D6E4"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Media Sosial"
                android:textColor="#E91E63"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Instagram: @qxyll.aa\nGitHub: AqilaFadilla25"
                android:textColor="#403840"
                android:textSize="14sp"
                android:lineSpacingExtra="7dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Tombol kembali -->
        <Button
            android:id="@+id/btnlogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="Logout"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#E91E63" />

    </LinearLayout>

</ScrollView>