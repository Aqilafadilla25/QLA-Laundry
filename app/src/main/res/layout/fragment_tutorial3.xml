<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FCEAF2">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:src="@drawable/mobil_laundry"
        android:scaleType="fitCenter"
        android:contentDescription="Mobil Jemput Laundry" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Jemput dan Antar Laundry"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#C2185B"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Pesan layanan jemput dan antar laundry dengan mudah tanpa harus keluar rumah."
        android:textSize="16sp"
        android:textColor="#444444"
        android:lineSpacingExtra="6dp"
        android:layout_marginTop="12dp" />

</LinearLayout>
