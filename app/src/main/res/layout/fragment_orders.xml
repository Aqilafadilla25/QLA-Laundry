<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCEAF2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- JUDUL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pesanan Laundry"
            android:textColor="#E91E63"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Pilih layanan laundry sesuai kebutuhanmu"
            android:textColor="#6D5963"
            android:textSize="14sp" />

        <!-- LAYANAN 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cuci Reguler"
                android:textColor="#29212A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pakaian bersih dengan proses 2–3 hari"
                android:textColor="#6D5963"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Rp7.000 / kg"
                android:textColor="#E91E63"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPesanReguler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#E91E63"
                android:text="Pilih Layanan"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- LAYANAN 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cuci + Setrika"
                android:textColor="#29212A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pakaian bersih, licin, dan siap digunakan"
                android:textColor="#6D5963"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Rp10.000 / kg"
                android:textColor="#E91E63"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPesanSetrika"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#E91E63"
                android:text="Pilih Layanan"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- LAYANAN 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cuci Bedcover"
                android:textColor="#29212A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Layanan untuk bedcover dan selimut"
                android:textColor="#6D5963"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Mulai Rp20.000"
                android:textColor="#E91E63"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPesanBedcover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#E91E63"
                android:text="Pilih Layanan"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- BAGIAN CRUD FITUR 2: DAFTAR PESANAN (SUPABASE) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daftar Pesanan Masuk"
            android:textColor="#E91E63"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:layout_marginBottom="20dp" />

        <!-- FITUR BARU RATING DAN ULASAN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⭐ Rating dan Ulasan"
                android:textColor="#29212A"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bagikan pengalamanmu menggunakan layanan Laundry Express. Penilaian kamu sangat berarti bagi kami!"
                android:textColor="#6D5963"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"/>

            <Button
                android:id="@+id/btnBeriRating"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#E91E63"
                android:text="Beri Rating Sekarang ★"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>