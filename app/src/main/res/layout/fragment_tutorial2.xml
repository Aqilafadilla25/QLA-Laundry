<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F9E0EB">

    <!-- Logo Laundry dengan sudut membulat -->

    <ImageView
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="center"
        android:background="@drawable/layanan_praktis"
        android:clipToOutline="true"
        android:contentDescription="Logo Laundry Qla Cimol"
        android:padding="8dp"
        android:scaleType="fitCenter" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Layanan Laundry Praktis"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#C2185B"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Nikmati pilihan cuci reguler, cuci setrika, dan cuci bedcover sesuai kebutuhanmu."
        android:textSize="16sp"
        android:textColor="#444444"
        android:lineSpacingExtra="6dp"
        android:layout_marginTop="16dp" />

</LinearLayout>
